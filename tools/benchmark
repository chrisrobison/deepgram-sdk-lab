#!/usr/bin/env python3
"""Offline decode and generator baseline; no live API access."""

from __future__ import annotations

import os
import pathlib
import subprocess
import sys
import time

ROOT = pathlib.Path(__file__).resolve().parents[1]
FIXTURE = ROOT / "tests/fixtures/prerecorded-response.json"
ITERATIONS = sys.argv[1] if len(sys.argv) > 1 else "10000"


def run(command: list[str]) -> None:
    started = time.perf_counter()
    result = subprocess.run(command, cwd=ROOT, env=os.environ.copy(), check=True, capture_output=True, text=True)
    print(result.stdout.strip())
    print(f"wall_seconds={time.perf_counter() - started:.4f}")


run(["swift", "run", "-c", "release", "deepgram-bench", str(FIXTURE), ITERATIONS])
run(["php", "sdks/php/benchmarks/decode.php", str(FIXTURE), ITERATIONS])
run([str(ROOT / "tools/generate"), "all"])
