#!/usr/bin/env python3
"""Validate planned monorepo release metadata; never tag or publish."""

from __future__ import annotations

import json
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[1]


def main() -> int:
    version = json.loads((ROOT / "version.json").read_text())["project"]
    if not re.fullmatch(r"(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)", version):
        print("invalid project SemVer", file=sys.stderr)
        return 1
    swift = (ROOT / "sdks/swift/Sources/Deepgram/Deepgram.swift").read_text()
    php = (ROOT / "sdks/php/src/Client.php").read_text()
    if f'public static let version = "{version}"' not in swift or f"public const VERSION = '{version}'" not in php:
        print("SDK runtime versions differ from version.json", file=sys.stderr)
        return 1
    root_composer = json.loads((ROOT / "composer.json").read_text())
    nested_composer = json.loads((ROOT / "sdks/php/composer.json").read_text())
    if (root_composer["name"] != nested_composer["name"] or root_composer["require"] != nested_composer["require"]
            or root_composer.get("require-dev") != nested_composer.get("require-dev")):
        print("Composer manifests have drifted", file=sys.stderr)
        return 1
    spec = json.loads((ROOT / "specs/source.json").read_text())
    tag = f"v{version}"
    exists = subprocess.run(["git", "tag", "--list", tag], cwd=ROOT, capture_output=True, text=True, check=True).stdout.strip()
    if exists:
        print(f"tag {tag} already exists", file=sys.stderr)
        return 1
    print(f"Dry run: would create {tag} for SwiftPM and Composer from the repository root")
    print(f"Pinned Deepgram spec: {spec['commit']}")
    print("No tag, GitHub release, package registry, or Packagist entry was created.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
