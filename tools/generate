#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
case "${1:-}" in
  swift) python3 "$root/generators/swift/generate.py" ;;
  php) python3 "$root/generators/php/generate.py" ;;
  all) python3 "$root/generators/swift/generate.py"; python3 "$root/generators/php/generate.py" ;;
  *) echo 'usage: ./tools/generate swift|php|all' >&2; exit 2 ;;
esac
